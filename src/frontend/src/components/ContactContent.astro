---
import PortfolioHero from "./PortfolioHero.astro";
import { CONTACT } from "../lib/contact";
import { t } from "../lib/i18n";

interface Props { lang: "sk" | "en"; }
const { lang } = Astro.props;
const bookingHref = lang === "sk" ? "/sk/rezervacia" : "/en/booking";
---

<PortfolioHero title={t(lang, "contact.title")} subtitle={t(lang, "contact.subtitle")} />

<section class="contact">
  <ul class="contact__grid">
    <li class="contact__card">
      <svg class="contact__icon" viewBox="0 0 24 24" aria-hidden="true">
        <rect width="20" height="16" x="2" y="4" rx="2" />
        <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" />
      </svg>
      <h2 class="contact__card-title">{t(lang, "contact.emailTitle")}</h2>
      <a class="contact__link" href={`mailto:${CONTACT.email}`}>{CONTACT.email}</a>
      <p class="contact__note">{t(lang, "contact.emailNote")}</p>
    </li>

    <li class="contact__card">
      <svg class="contact__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" />
      </svg>
      <h2 class="contact__card-title">{t(lang, "contact.phoneTitle")}</h2>
      <a class="contact__link" href={`tel:${CONTACT.phoneHref}`}>{CONTACT.phoneDisplay}</a>
      <p class="contact__note">{t(lang, "contact.phoneNote")}</p>
    </li>

    <li class="contact__card">
      <svg class="contact__icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z" />
        <circle cx="12" cy="10" r="3" />
      </svg>
      <h2 class="contact__card-title">{t(lang, "contact.locationTitle")}</h2>
      <p class="contact__value">{t(lang, "footer.address")}</p>
      <p class="contact__note">{t(lang, "contact.locationNote")}</p>
    </li>
  </ul>

  <div class="contact__social">
    <h2 class="contact__social-title">{t(lang, "contact.socialTitle")}</h2>
    <ul class="contact__social-list">
      <li>
        <a class="contact__social-link" href={CONTACT.instagram} rel="noopener noreferrer" target="_blank">
          <svg class="contact__social-icon" viewBox="0 0 24 24" aria-hidden="true">
            <rect width="20" height="20" x="2" y="2" rx="5" ry="5" />
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
            <line x1="17.5" x2="17.51" y1="6.5" y2="6.5" />
          </svg>
          Instagram
        </a>
      </li>
      <li>
        <a class="contact__social-link" href={CONTACT.facebook} rel="noopener noreferrer" target="_blank">
          <svg class="contact__social-icon" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z" />
          </svg>
          Facebook
        </a>
      </li>
    </ul>
  </div>

  <div class="contact__cta">
    <h2 class="contact__cta-title">{t(lang, "contact.ctaTitle")}</h2>
    <p class="contact__cta-text">{t(lang, "contact.ctaText")}</p>
    <a class="contact__cta-btn" href={bookingHref}>{t(lang, "contact.ctaButton")}</a>
  </div>
</section>

<style lang="scss">
  @use "../styles/components/contact";
</style>
